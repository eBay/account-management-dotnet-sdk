<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EBay.AccountManagement</RootNamespace>
    <AssemblyName>EBay.AccountManagement</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>2.0.0</Version>
    <Authors>eBay</Authors>
    <Description>Account Management SDK for eBay APIs - combines REST and GraphQL clients</Description>
    <PackageProjectUrl>https://github.com/eBay/account-management-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eBay/account-management-dotnet-sdk</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- REST: Kiota runtime (includes Abstractions, Http, Serialization) -->
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />

    <!-- GraphQL: StrawberryShake runtime + Roslyn source generator -->
    <PackageReference Include="StrawberryShake.Server" Version="16.*" />
  </ItemGroup>

</Project>
